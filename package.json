{
  "name": "al-rabbaniyyun-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "build:android": "node scripts/build-android.mjs",
    "cap:sync": "npx cap sync android",
    "cap:assets": "node scripts/generate-capacitor-assets.mjs && npx @capacitor/assets generate --android",
    "deploy:check": "node scripts/check-deploy-env.mjs",
    "prebuild": "node scripts/generate-book-manifest.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
  "test:unit": "vitest run src",
    "test:ui": "node qa/scan.mjs",
    "test:e2e": "playwright test",
    "manifest": "node scripts/generate-book-manifest.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "quran:generate": "node scripts/generate-quran-asset.mjs",
    "quran:check": "node scripts/check-quran-content.mjs",
    "quran:import": "node scripts/import-quran-content.mjs",
    "hadith:generate": "node scripts/generate-hadith-asset.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "db:plan": "node scripts/apply-cloud-schema.mjs --dry-run",
    "db:migrate": "node scripts/apply-cloud-schema.mjs",
    "prayer:check": "node scripts/check-prayer-accuracy.mjs",
    "cache:purge": "node scripts/purge-cloudflare-cache.mjs",
    "build:local": "node scripts/build-local.mjs",
    "dev:local": "node -e \"process.env.VITE_LOCAL_ONLY='true';require('child_process').spawn('npx', ['vite','--host','0.0.0.0'],{stdio:'inherit',shell:true,env:process.env})\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "geomagnetism": "^0.2.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "adhan": "^4.4.6",
    "pg": "^8.23.1",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "~5.7.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
